struct Totals { value: i32, active: bool }

fn main() -> i32 {
    var values: [i32; 3] = [10, 20, 12];
    var total: Totals = Totals { value: 0, active: true };
    var i: i32 = 0;
    while i < 3 {
        var j: i32 = 0;
        while j < 2 {
            j = j + 1;
            continue;
        }
        total.value = total.value + values[i];
        i = i + 1;
    }
    while total.active {
        total.active = false;
        break;
    }
    return (total.value << 1) / 2;
}
